<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/stepIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textAppearance="@style/TextAppearance.Organizer.Caption" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/stepLauncher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Set as your Home app" android:textAppearance="@style/TextAppearance.Organizer.Headline" />
                <TextView android:id="@+id/launcherStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Organizer.Body" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="After tapping below and selecting OrionMD Launcher, press the Back button to return here and continue setup."
                    android:textAppearance="@style/TextAppearance.Organizer.Caption" android:alpha="0.7" />
                <Button android:id="@+id/btnSetDefaultLauncher" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="Open Home app settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepOwnerHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Choose Owner's home apps" android:textAppearance="@style/TextAppearance.Organizer.Headline" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tip: pinch outward on the home screen anytime to switch between Guest and Owner — works both ways, no PIN needed."
                    android:textAppearance="@style/TextAppearance.Organizer.Caption" android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <Button android:id="@+id/btnSelectAllOwnerHome" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:text="Select all" />
                    <Button android:id="@+id/btnSelectNoneOwnerHome" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:text="Select none" />
                </LinearLayout>
                <LinearLayout android:id="@+id/ownerHomeChecklist" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepGuestHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Choose Guest's home apps" android:textAppearance="@style/TextAppearance.Organizer.Headline" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Remember: pinch outward on the home screen to switch back to Owner anytime."
                    android:textAppearance="@style/TextAppearance.Organizer.Caption" android:alpha="0.7" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <Button android:id="@+id/btnSelectAllGuestHome" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:text="Select all" />
                    <Button android:id="@+id/btnSelectNoneGuestHome" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:text="Select none" />
                </LinearLayout>
                <LinearLayout android:id="@+id/guestHomeChecklist" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepGuestDrawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Choose what Guest can see in the app drawer" android:textAppearance="@style/TextAppearance.Organizer.Headline" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <Button android:id="@+id/btnSelectAllGuestDrawer" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:text="Select all" />
                    <Button android:id="@+id/btnSelectNoneGuestDrawer" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:text="Select none" />
                </LinearLayout>
                <LinearLayout android:id="@+id/guestDrawerChecklist" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepWallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Pick a wallpaper" android:textAppearance="@style/TextAppearance.Organizer.Headline" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:id="@+id/wallpaperGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <Button android:id="@+id/btnBack" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/btnNext"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next" />
    </LinearLayout>

</LinearLayout>
