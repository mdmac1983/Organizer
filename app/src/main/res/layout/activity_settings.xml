<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="Settings"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:padding="16dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDarkTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use dark theme"
            android:paddingHorizontal="16dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDynamicColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use Material You dynamic color"
            android:paddingHorizontal="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnChangePin"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="Change app PIN" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Storage"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:padding="16dp" />

        <TextView
            android:id="@+id/storagePermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="Storage permission: checking..."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/btnRequestStorage"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Grant storage permission" />

    </LinearLayout>

</ScrollView>
