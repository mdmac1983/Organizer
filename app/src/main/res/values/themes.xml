<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="TextAppearance.Organizer.Bold" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Theme.Organizer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/gray_200</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorSurface">@color/gray_50</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/gray_100</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="colorOutline">@color/gray_400</item>
        <item name="colorOutlineVariant">@color/gray_300</item>
        <item name="android:windowBackground">@color/gray_50</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Organizer.Bold</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Organizer.Bold</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Organizer.Bold</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Organizer.Bold</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Organizer.Bold</item>
    </style>

</resources>
