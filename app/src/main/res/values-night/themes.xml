<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Same type scale as light theme, but text color set for dark surfaces -->
    <style name="TextAppearance.Organizer.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Organizer.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Organizer.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Organizer.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Organizer.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.Organizer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/teal_dark_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/teal_dark_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="colorOutline">@color/teal_muted</item>
        <item name="colorOutlineVariant">@color/dark_surface_variant</item>
        <item name="android:windowBackground">@color/dark_surface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Organizer.Caption</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Organizer.Caption</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Organizer.Body</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Organizer.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Organizer.Body</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Organizer.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Organizer.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Organizer.Display</item>
    </style>

</resources>
